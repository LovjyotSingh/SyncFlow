# Postgres. On Vercel this is set by the Neon integration.
# Leave it empty locally and SyncFlow uses an embedded Postgres (PGlite) in ./.data.
DATABASE_URL=

# Signs session cookies. Required in production, at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=

# File sharing. On Vercel this is set when you connect a Blob store to the project.
BLOB_READ_WRITE_TOKEN=

# Email codes (confirm email, reset password). Leave empty to turn email off.
# Gmail: SMTP_HOST=smtp.gmail.com SMTP_PORT=465 SMTP_USER=you@gmail.com SMTP_PASS=<16-char app password>
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="SyncFlow <you@gmail.com>"
# Links in emails. Defaults to the Vercel production URL.
APP_URL=
